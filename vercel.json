{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/redirect"
    },
    {
      "source": "/go",
      "destination": "/api/go"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}